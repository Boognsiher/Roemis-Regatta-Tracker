# Kopieren nach ".env" und Wert anpassen.
# Dieses Token schuetzt den Admin-Bereich (neue Tracker anlegen/loeschen).
ADMIN_TOKEN=bitte-durch-ein-langes-zufaelliges-token-ersetzen

PORT=3000

# Nach wie vielen Sekunden ohne Update ein Tracker als "offline" (stale) gilt.
STALE_AFTER_SECONDS=90

# Wie viele Positions-Punkte pro Tracker als Spur auf der Karte behalten werden.
MAX_TRAIL_POINTS=1000

# Optional: Token nur fuer das Gateway-Handy (LoRa-Master). Darf nur Positionen melden.
GATEWAY_TOKEN=

# Nur fuer den Cloudflare Tunnel (docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=

# Port, unter dem die App im LAN erreichbar ist (Standard 3000). Nur aendern, wenn 3000 auf dem NAS belegt ist.
# Der Cloudflare Tunnel braucht das nicht (er nutzt intern Port 3000).
HOST_PORT=3000

# Sperre nach Fehlversuchen (optional): Anzahl falscher Tokens in 15 min bis zur Sperre / Dauer der Sperre
# AUTH_MAX_FAILURES=8
# AUTH_BLOCK_MINUTES=15

# Zuschauer-Passwort: gesetzt -> Live-Karte und Ergebnisse nur nach Login (/login.html), leer -> oeffentlich.
# Das Admin-Token meldet ebenfalls an. Passwort aendern = alle bestehenden Anmeldungen werden ungueltig.
VIEWER_PASSWORD=
# Optional zusaetzliches Geheimnis fuer die Cookie-Signatur
# SESSION_SECRET=
