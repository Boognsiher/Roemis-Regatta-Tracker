#pragma once
/*
 * Geraetespezifische Zugangsdaten fuer den Logger. Kopieren nach include/secrets.h (wird nicht committet).
 * Pro Geraet anders: TRACKER_ID, SERVER_ID, TRACKER_TOKEN. Im Admin-Bereich gibt es beim Tracker den Knopf
 * "Firmware-Config kopieren", der die drei Zeilen mit den richtigen Werten erzeugt.
 */

// Hotspot deines Handys (gilt fuer Logger UND LoRa-Tracker) (2.4 GHz! ESP32 kann kein 5 GHz). Feste Werte, damit sich die Geraete automatisch verbinden.
#define WIFI_SSID      "RegattaHotspot"
#define WIFI_PASSWORD  "bitte-aendern"

// Server (ohne / am Ende)
#define SERVER_URL     "https://regatta.example.org"

// Vom Admin-Knopf erzeugt:
#define TRACKER_ID     1
#define SERVER_ID      "abc123"
#define TRACKER_TOKEN  "token-aus-dem-admin"

// TLS: Root-Zertifikat der Server-Zertifizierungsstelle als PEM (z.B. Let's Encrypt:
//   curl -O https://letsencrypt.org/certs/isrgrootx1.pem). Zwischen die Klammern einfuegen.
static const char SERVER_CA_PEM[] = R"CERT(
)CERT";
// Nur fuer Tests im eigenen Netz (http:// oder ungeprueftes TLS). Im Einsatz auf 0 lassen.
#define ALLOW_INSECURE_TLS 0
